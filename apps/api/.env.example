# Moving an existing game: preserve your original .env and database instead of replacing them.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/projectdnd
JWT_SECRET=replace-with-your-own-random-secret-at-least-32-characters
PORT=3001
WEB_PORT=5242
WEB_ORIGIN=http://localhost:5242
UPLOAD_DIR=uploads

# Windows Server / Ryzen 5 5600G / 32 GB. Defaults already apply without adding these.
DND_RUN_MODE=production
DND_NODE_HEAP_MB=4096
DND_WORKER_THREADS=8
DND_IMAGE_THREADS=2
DND_IMAGE_CACHE_MB=128
