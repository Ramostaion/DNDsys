{
  "name": "project-dnd",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @dnd/api --filter @dnd/web dev",
    "build": "pnpm -r build && node scripts/prepare-web-assets.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "lint": "eslint apps packages",
    "db:generate": "pnpm --filter @dnd/api prisma generate",
    "db:migrate": "pnpm --filter @dnd/api prisma migrate dev",
    "db:seed": "pnpm --filter @dnd/api seed",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"apps/api/e2e/**/*.ts\" \"packages/shared/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx}\" \"apps/api/e2e/**/*.ts\" \"packages/shared/src/**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.71.1"
  }
}
